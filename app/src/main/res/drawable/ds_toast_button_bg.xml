<?xml version="1.0" encoding="utf-8"?>
<!-- The button of the TV-recovery toast: a chip on the toast background, focused with the design-system
     control outline. The text is the on-toast color, the button uses the focused and the pressed controls. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="?attr/tbColorDsControlFocused" />
            <stroke android:color="?attr/tbColorDsFocus" android:width="@dimen/ds_focus_outline" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="?attr/tbColorDsControlFocused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="?attr/tbColorDsControl" />
        </shape>
    </item>
</selector>
