<?xml version="1.0" encoding="utf-8"?>
<!-- On a TV that got the phone interface by accident: a toast with the button to get the TV one back -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/ds_size_toast_min_width"
    android:background="@drawable/ds_toast_bg"
    android:elevation="4dp"
    android:padding="@dimen/ds_toast_padding_horizontal"
    android:gravity="center"
    android:orientation="horizontal">
    <ImageView android:id="@+id/ivIcon"
        android:layout_width="@dimen/ds_size_icon_toast"
        android:layout_height="@dimen/ds_size_icon_toast"
        android:src="@drawable/ic_remote"
        app:tint="?attr/tbColorDsOnToast"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_remote" />
    <TextView android:id="@+id/tvMessage"
        style="@style/Widget.TVBro.Text.Toast"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/ds_space_icon_text"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="@string/settings_interface_summary_phone_warning"
        android:textColor="?attr/tbColorDsOnToast"
        tools:text="Phone interface: the remote is limited" />
    <TextView android:id="@+id/vbAction"
        style="@style/Widget.TVBro.TextButton.Ds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_icon_text"
        android:background="@drawable/ds_toast_button_bg"
        android:paddingStart="@dimen/ds_panel_text_button_padding"
        android:paddingEnd="@dimen/ds_panel_text_button_padding"
        android:text="@string/restore_tv_mode"
        android:textColor="?attr/tbColorDsInk"
        tools:text="Restore TV interface" />
</LinearLayout>
